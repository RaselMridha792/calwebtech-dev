# Production stack. Copy to /srv/calwebtech/env/production.env on the server, chmod 600,
# and fill in every empty value; infra/scripts/bootstrap-server.sh does the copy and
# generates the secrets. This file is read twice: by Compose for the stack settings, and by
# every container through APP_ENV_FILE. Never commit the filled-in copy.
#
# Production deploys by hand only: Actions > release > "Run workflow" with a commit SHA
# (.github/workflows/release.yml, deploy-manual). Nothing seeds this database, so the
# first deploy needs content in it before the smoke test can pass (docs/11-vps-deploy.md).

# ---- stack
STACK=production
APP_ENV=production
NODE_ENV=production
SITE_HOST=calwebtech.com
APP_ORIGIN=https://calwebtech.com
APP_ENV_FILE=/srv/calwebtech/env/production.env
# The security headers every stack carries (infra/traefik/dynamic/security.yml), then
# compression. No basic auth and no X-Robots-Tag here: indexing is the site.indexing and
# homepage.indexing settings' decision, flipped with settings-cli, not the edge's.
EDGE_MIDDLEWARES=security-headers@file,edge-compress@file
# The shared proxy mounts this directory whatever the stack; production keeps nothing in it.
TRAEFIK_SECRETS_DIR=/srv/calwebtech/secrets
ACME_EMAIL=
# Set by deploy.sh to the commit SHA that last passed the smoke test.
TAG=
GHCR_IMAGE_WEB=ghcr.io/raselmridha792/calwebtech-dev-web
GHCR_IMAGE_API=ghcr.io/raselmridha792/calwebtech-dev-api
GHCR_IMAGE_WORKER=ghcr.io/raselmridha792/calwebtech-dev-worker

# ---- api
# Web reaches its own stack's API by the alias in infra/docker-compose.yml.
API_INTERNAL_URL=http://production-api:4000
API_PORT=4000
# Traefik is the one proxy in front of the API. Raise this only if Cloudflare is put in
# front of the server (docs/06 Task 6.3), or every visitor shares one rate limit.
TRUST_PROXY_HOPS=1

# ---- database (this stack's own; generate the password with `openssl rand -hex 24`)
POSTGRES_USER=calwebtech
POSTGRES_PASSWORD=
POSTGRES_DB=calwebtech
# The same password again: env files do not expand variables.
DATABASE_URL=postgresql://calwebtech:<POSTGRES_PASSWORD>@db:5432/calwebtech
REDIS_URL=redis://redis:6379

# ---- secrets (generate with `openssl rand -base64 32`)
AUTH_SECRET=
REVALIDATE_SECRET=

# ---- bot protection. Production fails closed (docs/08 decisions 18 and 26): with these
# empty the web server exits at startup and the API refuses to start, so the deploy rolls
# back rather than serve forms without a check. Create a Turnstile widget for SITE_HOST in
# the Cloudflare dashboard (free, no DNS change needed) and paste both keys. Cloudflare's
# always-pass test keys (1x0000...) start the stack but check nothing; never leave them on
# a production host that takes real enquiries.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ---- email. `log` writes every email to the worker's log and sends nothing; leads are
# still stored. Switch to `resend` once the client's Resend account and sending domain
# exist, with SPF, DKIM and DMARC in place (docs/06 Task 6.2). EMAIL_FROM must be an
# address on a domain verified in that account. Leave EMAIL_REDIRECT_TO empty in
# production: it diverts every message to one inbox.
EMAIL_TRANSPORT=log
RESEND_API_KEY=
EMAIL_FROM="Calwebtech <hello@calwebtech.com>"
EMAIL_REDIRECT_TO=

# ---- deploy
# Never seed production: the seed replaces rows wholesale and refuses APP_ENV=production
# anyway (packages/db/src/seed/guard.ts).
SEED_ON_DEPLOY=false
# No basic auth on production, and no X-Robots-Tag; the smoke test checks HSTS instead.
SMOKE_BASIC_AUTH=
EXPECT_NOINDEX=false
EXPECT_HSTS=true

# ---- backups (ops profile, docs/01 "Backup and recovery")
GHCR_IMAGE_BACKUP=ghcr.io/raselmridha792/calwebtech-dev-backup
# Where restic keeps the encrypted snapshots: an account separate from the VPS, one path
# per stack. S3-compatible (Backblaze B2, Hetzner Object Storage) or over SSH:
#   s3:https://s3.<region>.backblazeb2.com/<bucket>/production
#   sftp:user@host:/path
RESTIC_REPOSITORY=
# Encrypts every snapshot (generate with `openssl rand -base64 32`). Keep a copy off the
# server: losing it loses every backup.
RESTIC_PASSWORD=
# Credentials for an s3: repository, read by restic as they are. Empty for sftp.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# HH:MM on the container clock, UTC unless TZ is set in this file. Retention is 7 daily,
# 4 weekly, 6 monthly unless BACKUP_KEEP_DAILY, _WEEKLY, _MONTHLY say otherwise.
BACKUP_TIME=03:00
# Optional: an Uptime Kuma push URL (status.<SITE_HOST>) fetched after every successful
# backup, so a missed night alerts.
BACKUP_HEALTHCHECK_URL=
