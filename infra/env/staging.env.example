# Staging stack. Copy to /srv/calwebtech/env/staging.env on the server, chmod 600, and
# fill in every empty value. This file is read twice: by Compose for the stack settings,
# and by every container through APP_ENV_FILE. Never commit the filled-in copy.

# ---- stack
STACK=staging
APP_ENV=staging
NODE_ENV=production
SITE_HOST=staging.calwebtech.com
APP_ORIGIN=https://staging.calwebtech.com
APP_ENV_FILE=/srv/calwebtech/env/staging.env
# Basic auth first, then noindex on every response, then the security headers every
# stack carries (infra/traefik/dynamic/security.yml), then compression.
EDGE_MIDDLEWARES=staging-auth@file,noindex@file,security-headers@file,edge-compress@file
TRAEFIK_SECRETS_DIR=/srv/calwebtech/secrets
ACME_EMAIL=
# Set by deploy.sh to the commit SHA.
TAG=
GHCR_IMAGE_WEB=ghcr.io/raselmridha792/calwebtech-dev-web
GHCR_IMAGE_API=ghcr.io/raselmridha792/calwebtech-dev-api
GHCR_IMAGE_WORKER=ghcr.io/raselmridha792/calwebtech-dev-worker

# ---- content (decision 43). `api`: pages come from the database, which the placeholder
# seed fills. `snapshot` previews what production shows: the approved demo content from
# apps/web/static-content, with forms still going to the API; then set SEED_ON_DEPLOY=false
# and IMPORT_SNAPSHOTS_ON_DEPLOY=true below.
CONTENT_SOURCE=api

# ---- api
# Web reaches its own stack's API by the alias in infra/docker-compose.yml.
API_INTERNAL_URL=http://staging-api:4000
API_PORT=4000
TRUST_PROXY_HOPS=1

# ---- database (this stack's own; generate the password with `openssl rand -hex 24`)
POSTGRES_USER=calwebtech
POSTGRES_PASSWORD=
POSTGRES_DB=calwebtech
# The same password again: env files do not expand variables.
DATABASE_URL=postgresql://calwebtech:<POSTGRES_PASSWORD>@db:5432/calwebtech
REDIS_URL=redis://redis:6379

# ---- secrets (generate with `openssl rand -base64 32`)
AUTH_SECRET=
REVALIDATE_SECRET=

# ---- bot protection. Cloudflare's always-pass test keys until the client's keys exist.
# Staging also starts with these empty (APP_ENV=staging); submissions are then stored and
# marked bot_check_unavailable.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# ---- email. Nothing is sent until the client's Resend account and domain exist.
EMAIL_TRANSPORT=log
RESEND_API_KEY=
EMAIL_FROM="Calwebtech <onboarding@resend.dev>"
EMAIL_REDIRECT_TO=delivered@resend.dev

# ---- deploy
# Staging re-runs the placeholder seed on every deploy. Never set this in production.
SEED_ON_DEPLOY=true
# Or, with CONTENT_SOURCE=snapshot above, the snapshot import instead of the seed
# (decision 43). One or the other: deploy.sh refuses both.
IMPORT_SNAPSHOTS_ON_DEPLOY=false
# user:password matching secrets/staging.htpasswd, for the smoke test.
SMOKE_BASIC_AUTH=
EXPECT_NOINDEX=true
# security-headers@file is in EDGE_MIDDLEWARES above, so every route must answer with HSTS.
EXPECT_HSTS=true

# ---- backups (ops profile, docs/01 "Backup and recovery")
GHCR_IMAGE_BACKUP=ghcr.io/raselmridha792/calwebtech-dev-backup
# Where restic keeps the encrypted snapshots: an account separate from the VPS, one path
# per stack. S3-compatible (Backblaze B2, Hetzner Object Storage) or over SSH:
#   s3:https://s3.<region>.backblazeb2.com/<bucket>/<stack>
#   sftp:user@host:/path
RESTIC_REPOSITORY=
# Encrypts every snapshot (generate with `openssl rand -base64 32`). Keep a copy off the
# server: losing it loses every backup.
RESTIC_PASSWORD=
# Credentials for an s3: repository, read by restic as they are. Empty for sftp.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# HH:MM on the container clock, UTC unless TZ is set in this file. Retention is 7 daily,
# 4 weekly, 6 monthly unless BACKUP_KEEP_DAILY, _WEEKLY, _MONTHLY say otherwise.
BACKUP_TIME=03:00
# Optional: an Uptime Kuma push URL (status.<SITE_HOST>) fetched after every successful
# backup, so a missed night alerts.
BACKUP_HEALTHCHECK_URL=
