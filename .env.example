# Copy to .env and fill in. Never commit .env. File mode 600 on the host.
# Local development reads this file from the repo root (apps/api and packages/db
# both look for ../../.env). Containers get the same keys through env_file.

# ---- core
NODE_ENV=development
# production, staging or development. Only production treats a missing Turnstile key as
# fatal, so staging can deploy before the client's keys exist. Unset means production.
APP_ENV=development
# Public origin of the site. The API is served on this same origin at /api.
APP_ORIGIN=http://localhost:3000
# Where the web app reaches the API. Inside Docker: http://<STACK>-api:4000
API_INTERNAL_URL=http://localhost:4000
API_PORT=4000
# Proxy hops whose X-Forwarded-For the API trusts. Only the web app calls the API.
TRUST_PROXY_HOPS=1

# ---- database
POSTGRES_USER=calwebtech
POSTGRES_PASSWORD=change_me
POSTGRES_DB=calwebtech
# Inside Docker the host is `db`; for local development use localhost.
DATABASE_URL=postgresql://calwebtech:change_me@localhost:5432/calwebtech

# ---- redis
REDIS_URL=redis://redis:6379

# ---- auth
AUTH_SECRET=generate_with_openssl_rand_base64_32
SESSION_COOKIE_NAME=cwt_session

# ---- revalidation
REVALIDATE_SECRET=generate_a_long_random_string

# ---- email (Resend used as transport only; segments live in our database)
# `resend` sends through Resend. `log` renders each email, logs it and sends nothing (CI).
EMAIL_TRANSPORT=resend
RESEND_API_KEY=
# Before the sending domain is verified, development uses "Calwebtech <onboarding@resend.dev>".
EMAIL_FROM="Calwebtech <hello@mail.calwebtech.com>"
# Development only: every email goes here instead of its recipients, e.g. delivered@resend.dev.
# Leave empty in production.
EMAIL_REDIRECT_TO=
EMAIL_SENDING_DOMAIN=mail.calwebtech.com
# The internal lead notification address is deliberately not an environment variable. It is
# the `leads.notificationRecipients` setting, and changing it needs no redeploy:
#   docker compose run --rm api node dist/settings-cli.js set leads.notificationRecipients '{"emails":["leads@calwebtech.com"]}'

# ---- bot protection (Cloudflare Turnstile)
# Development and CI use Cloudflare's always-pass test keys:
# site key 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ---- storage (local volume first; S3-compatible is the scale-out path)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- observability
SENTRY_DSN=
UMAMI_WEBSITE_ID=

# ---- deployment, one env file per stack (infra/env/staging.env.example for staging)
# Compose project suffix, Traefik router prefix and API alias: production or staging.
STACK=production
# Public host this stack answers on.
SITE_HOST=calwebtech.com
# Traefik middlewares in front of the stack. Staging adds staging-auth@file and noindex@file.
EDGE_MIDDLEWARES=edge-compress@file
# Absolute path of this file on the server; every container reads it.
APP_ENV_FILE=/srv/calwebtech/env/production.env
TRAEFIK_SECRETS_DIR=/srv/calwebtech/secrets
# Image tag deployed. infra/scripts/deploy.sh sets it to the commit SHA.
TAG=
GHCR_IMAGE_WEB=ghcr.io/<org>/calwebtech-web
GHCR_IMAGE_API=ghcr.io/<org>/calwebtech-api
GHCR_IMAGE_WORKER=ghcr.io/<org>/calwebtech-worker
ACME_EMAIL=ops@calwebtech.com
# Re-run the placeholder seed on every deploy. Staging only, never production.
SEED_ON_DEPLOY=false
# Smoke test: user:password for a host behind basic auth, and whether noindex is required.
SMOKE_BASIC_AUTH=
EXPECT_NOINDEX=false

# ---- backup
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
# HH:MM on the container clock (infra/scripts/backup-entrypoint.sh reads this, not a cron line).
BACKUP_TIME=03:00
