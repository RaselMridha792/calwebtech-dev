# Copy to .env and fill in. Never commit .env. File mode 600 on the host.

# ---- core
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://api:4000

# ---- database
POSTGRES_USER=calwebtech
POSTGRES_PASSWORD=change_me
POSTGRES_DB=calwebtech
DATABASE_URL=postgresql://calwebtech:change_me@db:5432/calwebtech

# ---- redis
REDIS_URL=redis://redis:6379

# ---- auth
AUTH_SECRET=generate_with_openssl_rand_base64_32
SESSION_COOKIE_NAME=cwt_session

# ---- revalidation
REVALIDATE_SECRET=generate_a_long_random_string

# ---- email (Resend used as transport only; segments live in our database)
RESEND_API_KEY=
EMAIL_FROM="Calwebtech <hello@mail.calwebtech.com>"
EMAIL_INTERNAL_TO=leads@calwebtech.com
EMAIL_SENDING_DOMAIN=mail.calwebtech.com

# ---- bot protection
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ---- storage (local volume first; S3-compatible is the scale-out path)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- observability
SENTRY_DSN=
UMAMI_WEBSITE_ID=

# ---- deployment
GHCR_IMAGE_WEB=ghcr.io/<org>/calwebtech-web
GHCR_IMAGE_API=ghcr.io/<org>/calwebtech-api
ACME_EMAIL=ops@calwebtech.com
PRIMARY_DOMAIN=calwebtech.com
STAGING_DOMAIN=staging.calwebtech.com

# ---- backup
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
BACKUP_SCHEDULE="0 3 * * *"
