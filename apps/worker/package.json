{
  "name": "@calwebtech/worker",
  "version": "0.0.0",
  "private": true,
  "description": "BullMQ consumer: sends email jobs through Resend and records each delivery against its lead.",
  "files": ["dist"],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run integration"
  },
  "dependencies": {
    "@calwebtech/db": "workspace:*",
    "@calwebtech/emails": "workspace:*",
    "@calwebtech/shared": "workspace:*",
    "bullmq": "6.3.4",
    "ioredis": "6.0.0",
    "resend": "6.28.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@calwebtech/config": "workspace:*",
    "@types/node": "22.20.2",
    "eslint": "9.39.5",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
