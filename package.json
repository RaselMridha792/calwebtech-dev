{
  "name": "calwebtech",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "dev": "pnpm build:packages && pnpm -r --parallel dev",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "lint": "pnpm build:packages && pnpm -r lint",
    "test": "pnpm build:packages && pnpm -r test",
    "test:integration": "pnpm build:packages && pnpm -r --if-present test:integration",
    "build": "pnpm typecheck && pnpm -r lint && pnpm -r --filter \"./apps/*\" build",
    "db:generate": "pnpm --filter @calwebtech/db generate",
    "db:migrate": "pnpm --filter @calwebtech/db migrate:dev",
    "db:deploy": "pnpm --filter @calwebtech/db migrate:deploy",
    "db:seed": "pnpm --filter @calwebtech/db seed",
    "db:seed:fixtures": "pnpm --filter @calwebtech/db seed:fixtures",
    "lh": "pnpm --filter @calwebtech/perf lh"
  }
}
