// Calwebtech platform schema.
// Forward-only migrations. Never edit the production schema by hand.
// Intent and field rationale: docs/02-content-model.md

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  runtime             = "nodejs"
  importFileExtension = "js"
}

// The connection URL lives in prisma.config.ts (Prisma 7).
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- identity

enum Role {
  OWNER
  EDITOR
  SALES
  VIEWER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(VIEWER)
  avatar       String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  sessions   Session[]
  auditLogs  AuditLog[]
  leadNotes  LeadNote[]
  ownedLeads Lead[]     @relation("LeadOwner")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------- shared

enum Status {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

// SEO fields are stored as `seo Json?` on each public content type and validated
// with seoSchema from packages/shared. Fallbacks are applied at render time.
// (Prisma composite types are MongoDB-only, so an embedded type is not possible.)

model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  reason     String?
  createdAt  DateTime @default(now())
}

model MediaAsset {
  id         String    @id @default(cuid())
  url        String
  altText    String // required: the media library rejects uploads without it
  mimeType   String
  width      Int?
  height     Int?
  sizeBytes  Int?
  variants   Json? // generated responsive and modern-format variants
  uploadedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
}

model PageSection {
  id         String   @id @default(cuid())
  sectionKey String   @unique // e.g. "home.hero", "global.announcement"
  heading    String?
  subheading String?
  body       String?
  mediaUrl   String?
  ctaLabel   String?
  ctaUrl     String?
  visible    Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

/// An AI provider's key and the model to use with it (docs/08-decisions.md, 64). Entered in the
/// dashboard rather than the server's environment, so it can change without a deploy. The key
/// is stored encrypted (AES-256-GCM) and never read back out to the dashboard; only its last
/// four characters are. A removed connection is deleted outright, key and all: the audit log
/// keeps the history, and a key that is no longer wanted should not survive anywhere.
model AiConnection {
  id            String    @id @default(cuid())
  /// An id from AI_PROVIDERS in packages/shared/src/ai-providers.ts.
  provider      String
  label         String
  model         String
  /// Only for a provider that has no fixed address of its own (Azure, a custom service).
  baseUrl       String?
  /// iv, auth tag and ciphertext, base64, as apps/api/src/admin/ai/credential-box.ts writes them.
  keyCipher     String
  /// Which server secret encrypted it: "credentials-key" or "auth-secret".
  keySource     String
  keyHint       String
  /// The connection the site uses. At most one is, kept so by the service.
  isDefault     Boolean   @default(false)
  lastTestAt    DateTime?
  lastTestOk    Boolean?
  lastTestMs    Int?
  lastTestError String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------- content

model ServiceCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  order       Int       @default(0)
  services    Service[]
}

model Service {
  id                String    @id @default(cuid())
  title             String
  slug              String    @unique
  shortDescription  String
  answerBlock       String // 2-3 sentence extraction target, rendered first
  icon              String?
  heroMediaUrl      String?
  problemStatement  String?
  deliverables      Json? // string[]
  processSteps      Json? // { title, body, duration }[]
  startingPriceBand String?
  /// Page copy beyond the columns above, validated by the services family schema
  /// (packages/shared/src/pages/services.ts). Null leaves those sections out.
  content           Json?
  order             Int       @default(0)
  status            Status    @default(DRAFT)
  publishedAt       DateTime?
  seo               Json? // seoSchema, packages/shared
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  categoryId   String?
  category     ServiceCategory? @relation(fields: [categoryId], references: [id])
  technologies Technology[]
  projects     Project[]
  industries   Industry[]
  faqs         Faq[]
  glossary     GlossaryTerm[]
  leads        Lead[]

  @@index([status, order])
}

model Industry {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  answerBlock  String
  heroCopy     String?
  painPoints   Json? // string[]
  integrations Json? // string[]
  /// Page copy beyond the columns above, validated by the industries family schema
  /// (packages/shared/src/pages/industries.ts). Null leaves those sections out.
  content      Json?
  order        Int      @default(0)
  status       Status   @default(DRAFT)
  seo          Json? // seoSchema, packages/shared
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  /// Removed from the admin. The row stays for the audit trail and its slug stays taken.
  deletedAt    DateTime?

  services Service[]
  projects Project[]
  faqs     Faq[]
}

model Technology {
  id              String  @id @default(cuid())
  name            String
  slug            String  @unique
  logoUrl         String?
  category        String // frontend, backend, cms, ecommerce, infrastructure, tooling
  proficiencyNote String?
  order           Int     @default(0)

  services     Service[]
  projects     Project[]
  landingPages LandingPage[]
}

model Project {
  id                 String    @id @default(cuid())
  title              String
  slug               String    @unique
  clientName         String
  clientAlias        String? // used when the real name cannot be published
  answerBlock        String
  summary            String // one line, shown on case study cards
  liveUrl            String?
  location           String? // "Ohio, USA" - shown as a card tag
  segment            String? // B2B, D2C, enterprise
  coverImageUrl      String?
  coverImageAlt      String? // required whenever coverImageUrl is set
  gallery            Json? // string[]
  challenge          String?
  approach           String?
  buildNotes         String?
  outcome            String?
  outcomeMetrics     Json // { value, label }[] - mandatory, minimum three
  duration           String?
  year               Int?
  featured           Boolean   @default(false)
  beforeImageUrl     String?
  afterImageUrl      String?
  beforeAfterMetrics Json? // { label, before, after }[]
  /// Presentation the columns cannot hold, validated by the work family schema
  /// (packages/shared/src/pages/work.ts): the page's own order of its services.
  content            Json?
  status             Status    @default(DRAFT)
  seo                Json? // seoSchema, packages/shared
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  industryId    String?
  industry      Industry?     @relation(fields: [industryId], references: [id])
  services      Service[]
  technologies  Technology[]
  testimonials  Testimonial[]
  landingPages  LandingPage[] @relation("LandingPageResults")
  beforeAfterOn LandingPage[] @relation("LandingPageBeforeAfter")

  @@index([status, featured])
}

model Demo {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  thumbnail   String?
  previewUrl  String
  industry    String?
  stack       String?
  description String?
  status      Status  @default(DRAFT)
}

model Testimonial {
  id         String    @id @default(cuid())
  clientName String
  role       String?
  company    String?
  avatarUrl  String?
  rating     Int       @default(5)
  quote      String
  source     String? // Google, Clutch, DesignRush, direct
  videoUrl   String?
  featured   Boolean   @default(false)
  consentAt  DateTime? // permission to publish
  date       DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  projectId    String?
  project      Project?      @relation(fields: [projectId], references: [id])
  landingPages LandingPage[]
}

/// Aggregated third-party ratings, refreshed on a schedule rather than called live,
/// so the render path never depends on a third-party API.
model ReviewSource {
  id          String   @id @default(cuid())
  platform    String   @unique // Google, Clutch, DesignRush, GoodFirms
  rating      Decimal  @db.Decimal(2, 1)
  reviewCount Int
  profileUrl  String?
  refreshedAt DateTime @default(now())
}

model PostCategory {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  order Int    @default(0)
  posts Post[]
}

model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  answerBlock String
  coverImage  String?
  body        String // MDX
  readingTime Int?
  featured    Boolean   @default(false)
  status      Status    @default(DRAFT)
  publishedAt DateTime?
  seo         Json? // seoSchema, packages/shared
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  authorId   String?
  author     TeamMember?   @relation(fields: [authorId], references: [id])
  categoryId String?
  category   PostCategory? @relation(fields: [categoryId], references: [id])
  tags       Tag[]

  @@index([status, publishedAt])
}

model Tag {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  posts Post[]
}

model GlossaryTerm {
  id              String   @id @default(cuid())
  term            String
  slug            String   @unique
  shortDefinition String // one sentence, rendered bold under the H1
  body            String
  example         String?
  status          Status   @default(DRAFT)
  seo             Json? // seoSchema, packages/shared
  updatedAt       DateTime @updatedAt

  relatedServiceId String?
  relatedService   Service? @relation(fields: [relatedServiceId], references: [id])
}

model Guide {
  id         String  @id @default(cuid())
  title      String
  slug       String  @unique
  summary    String // ungated: this is what ranks
  fileUrl    String
  coverImage String?
  pageCount  Int?
  status     Status  @default(DRAFT)
  seo        Json? // seoSchema, packages/shared
}

model Faq {
  id       String  @id @default(cuid())
  question String
  answer   String
  group    String? // pricing, process, technology, ownership, support
  order    Int     @default(0)

  serviceId     String?
  service       Service?     @relation(fields: [serviceId], references: [id])
  industryId    String?
  industry      Industry?    @relation(fields: [industryId], references: [id])
  locationId    String?
  location      Location?    @relation(fields: [locationId], references: [id])
  landingPageId String?
  landingPage   LandingPage? @relation(fields: [landingPageId], references: [id], onDelete: Cascade)
}

model TeamMember {
  id      String  @id @default(cuid())
  name    String
  slug    String  @unique
  role    String
  photo   String?
  bio     String?
  skills  Json?
  socials Json?
  order   Int     @default(0)
  active  Boolean @default(true)

  posts        Post[]
  landingPages LandingPage[]
}

model Award {
  id           String  @id @default(cuid())
  name         String
  category     String?
  year         Int
  awardingBody String?
  description  String?
  badgeUrl     String?
  projectName  String?
  order        Int     @default(0)
}

model Partner {
  id               String  @id @default(cuid())
  name             String
  logoUrl          String?
  tier             String?
  certification    String?
  meaningForClient String?
  quote            String?
  order            Int     @default(0)

  landingPages LandingPage[]
}

model Statistic {
  id     String  @id @default(cuid())
  label  String
  value  String
  suffix String?
  order  Int     @default(0)
}

/// The delivery process. One source for the homepage timeline, /process/ and
/// the landing page stepper.
model ProcessStep {
  id        String   @id @default(cuid())
  title     String // "Discovery"
  timing    String // "Week 1"
  summary   String // one line for compact timelines
  heading   String // "We work out what is actually wrong"
  body      String
  youGet    String[]
  weNeed    String[]
  imageUrl  String?
  imageAlt  String? // required whenever imageUrl is set
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Published engagement shapes. Shared by the homepage, /pricing/ and landing pages.
model PricingTier {
  id          String   @id @default(cuid())
  name        String
  priceLabel  String // "$12k to $25k"
  summary     String
  highlighted Boolean  @default(false) // the "most common" option
  active      Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Client names and logos for the trust bar.
model ClientLogo {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  logoAlt   String?
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Campaign landing page served at /lp/<slug>/. The template and section order
/// are fixed; campaign copy lives in `content` (landingPageContentSchema in
/// packages/shared) and proof is related from shared content types.
model LandingPage {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  status      Status    @default(DRAFT)
  noindex     Boolean   @default(true)
  content     Json // landingPageContentSchema, packages/shared
  seo         Json? // seoSchema, packages/shared
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  beforeAfterProjectId String?
  beforeAfterProject   Project? @relation("LandingPageBeforeAfter", fields: [beforeAfterProjectId], references: [id], onDelete: SetNull)

  results      Project[]         @relation("LandingPageResults")
  testimonials Testimonial[]
  team         TeamMember[]
  partners     Partner[]
  technologies Technology[]
  faqs         Faq[]
  attributions LeadAttribution[]

  @@index([status])
}

model JobOpening {
  id           String    @id @default(cuid())
  title        String
  slug         String    @unique
  type         String // full-time, contract
  location     String
  salaryBand   String?
  description  String
  requirements Json?
  status       Status    @default(DRAFT)
  validThrough DateTime?
}

// ---------------------------------------------------------------- locations

enum LocationTier {
  TIER_1
  TIER_2
  TIER_3
}

model Location {
  id              String       @id @default(cuid())
  city            String
  slug            String       @unique
  state           String?
  tier            LocationTier @default(TIER_2)
  answerBlock     String
  serviceArea     String?
  localContext    String // the 60% unique content lives here
  localIndustries Json? // string[]
  localClients    Json? // string[]
  address         String?
  phone           String?
  latitude        Float?
  longitude       Float?
  /// Page copy beyond the columns above, validated by the locations family schema
  /// (packages/shared/src/pages/locations.ts). Null leaves those sections out.
  content         Json?
  status          Status       @default(DRAFT)
  seo             Json? // seoSchema, packages/shared
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  faqs Faq[]

  // self-relation, capped at six in application logic
  nearbyIds Json?
}

// ---------------------------------------------------------------- leads

enum LeadType {
  PROJECT
  SERVICE_ENQUIRY
  CONSULTATION
  CONTACT
  CALCULATOR
  AUDIT
  RESOURCE
  CAREERS
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

/// One canonical person. Leads, bookings and subscribers all resolve to a Contact so
/// the same human is never counted three times.
model Contact {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  phone     String?
  company   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads      Lead[]
  bookings   Booking[]
  subscriber Subscriber?
}

model Lead {
  id              String     @id @default(cuid())
  type            LeadType
  status          LeadStatus @default(NEW)
  name            String
  email           String
  phone           String?
  company         String?
  message         String?
  budgetBand      String?
  timeline        String?
  projectType     String?
  siteUrl         String?
  serviceInterest String[]
  referralSource  String? // "How did you find us", includes AI assistants
  /// Calculator answers and any other structured payload, stored as queryable fields.
  answers         Json?
  consentAt       DateTime?
  value           Decimal?   @db.Decimal(12, 2)
  /// When the owner has undertaken to act next. Set from the pipeline panel; null until
  /// someone commits to a date, which is different from a date that has passed.
  nextActionDate  DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])
  ownerId   String?
  owner     User?    @relation("LeadOwner", fields: [ownerId], references: [id])

  attribution LeadAttribution?
  activities  LeadActivity[]
  notes       LeadNote[]
  uploads     FileUpload[]
  bookings    Booking[]

  @@index([type, status, createdAt])
  @@index([email])
}

model LeadAttribution {
  id            String   @id @default(cuid())
  leadId        String   @unique
  firstTouchUtm Json?
  lastTouchUtm  Json?
  referrer      String?
  landingPage   String?
  device        String?
  campaignId    String?
  formId        String? // which form on the page, e.g. "lp-hero"
  landingPageId String?
  createdAt     DateTime @default(now())

  lead         Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaignPage LandingPage? @relation(fields: [landingPageId], references: [id], onDelete: SetNull)

  @@index([landingPageId])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  type      String // status_change, email_sent, call_logged, form_resubmitted
  detail    Json?
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  userId    String?
  body      String
  createdAt DateTime @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])
}

model FileUpload {
  id        String   @id @default(cuid())
  leadId    String?
  url       String
  filename  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  lead Lead? @relation(fields: [leadId], references: [id])
}

model EnquiryType {
  id          String  @id @default(cuid())
  name        String // new project, support, partnership, careers, press
  slug        String  @unique
  mailbox     String
  autoReplyId String?
  order       Int     @default(0)
}

// ---------------------------------------------------------------- bookings

enum BookingStatus {
  CONFIRMED
  RESCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model ConsultationType {
  id               String  @id @default(cuid())
  name             String
  slug             String  @unique
  durationMinutes  Int
  bufferBefore     Int     @default(0)
  bufferAfter      Int     @default(0)
  description      String?
  requiresApproval Boolean @default(false)
  active           Boolean @default(true)

  bookings Booking[]
  rules    AvailabilityRule[]
}

model AvailabilityRule {
  id                 String  @id @default(cuid())
  consultationTypeId String?
  weekday            Int // 0-6
  startMinute        Int // minutes from midnight, in the business timezone
  endMinute          Int
  minimumNoticeHours Int     @default(24)

  consultationType ConsultationType? @relation(fields: [consultationTypeId], references: [id])
}

model AvailabilityOverride {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  blocked     Boolean  @default(true)
  startMinute Int?
  endMinute   Int?
  reason      String?

  @@unique([date])
}

model Booking {
  id                 String        @id @default(cuid())
  consultationTypeId String
  contactId          String?
  leadId             String?
  name               String
  email              String
  phone              String?
  timezone           String
  startsAt           DateTime
  endsAt             DateTime
  /// The instant the call holds while it is on: `startsAt`, or null once it is cancelled. The
  /// unique index below is on this, so the database still refuses two calls at one time and a
  /// cancelled call gives its time back (docs/08-decisions.md, 60).
  slotStartsAt       DateTime?
  status             BookingStatus @default(CONFIRMED)
  context            String?
  rescheduleToken    String        @unique
  cancelToken        String        @unique
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  consultationType ConsultationType @relation(fields: [consultationTypeId], references: [id])
  contact          Contact?         @relation(fields: [contactId], references: [id])
  lead             Lead?            @relation(fields: [leadId], references: [id])
  events           BookingEvent[]

  /// Database-level double-booking prevention. Client-side checks are not sufficient.
  @@unique([consultationTypeId, slotStartsAt])
  @@index([startsAt, status])
}

model BookingEvent {
  id        String   @id @default(cuid())
  bookingId String
  type      String // created, reminded_24h, reminded_1h, rescheduled, cancelled
  detail    Json?
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------- audience

model Subscriber {
  id             String    @id @default(cuid())
  contactId      String?   @unique
  email          String    @unique
  name           String?
  sourcePage     String?
  consentAt      DateTime
  consentIp      String?
  unsubscribedAt DateTime?
  lastEngagedAt  DateTime?
  createdAt      DateTime  @default(now())

  contact    Contact?            @relation(fields: [contactId], references: [id])
  tags       SubscriberTag[]
  recipients CampaignRecipient[]
}

model SubscriberTag {
  subscriberId String
  tagName      String

  subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@id([subscriberId, tagName])
}

/// Separate from subscription state. An unsubscribe can never be undone by an import.
model Suppression {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String // unsubscribe, hard_bounce, complaint, manual
  createdAt DateTime @default(now())
}

model Segment {
  id          String   @id @default(cuid())
  name        String
  description String?
  /// Rule tree, re-evaluated at send time rather than materialised.
  rules       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns Campaign[]
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  subject     String
  preheader   String?
  templateKey String
  body        Json // block editor document
  status      CampaignStatus @default(DRAFT)
  scheduledAt DateTime?
  sentAt      DateTime?
  segmentId   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  segment    Segment?            @relation(fields: [segmentId], references: [id])
  recipients CampaignRecipient[]
}

model CampaignRecipient {
  id           String    @id @default(cuid())
  campaignId   String
  subscriberId String?
  email        String
  providerId   String? // Resend message id
  sentAt       DateTime?
  deliveredAt  DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  bouncedAt    DateTime?
  complainedAt DateTime?
  /// Set when this recipient will not be sent to: every attempt failed, or the address was
  /// suppressed or unsubscribed between the audience being counted and its turn to send.
  failedAt     DateTime?
  /// Why, in a word or a provider message: `suppressed`, `unsubscribed`, or the last error.
  error        String?

  campaign   Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriber Subscriber? @relation(fields: [subscriberId], references: [id])

  @@unique([campaignId, email])
  @@index([campaignId, sentAt])
}

model EmailEvent {
  id         String   @id @default(cuid())
  providerId String?
  email      String
  type       String // delivered, opened, clicked, bounced, complained
  payload    Json?
  occurredAt DateTime @default(now())

  @@index([email, type])
}

model Automation {
  id        String   @id @default(cuid())
  key       String   @unique // welcome, booking_reminder, post_call, unconverted_nudge
  name      String
  enabled   Boolean  @default(false)
  /// Ordered steps: { delayHours, templateKey, condition }
  steps     Json
  updatedAt DateTime @updatedAt

  runs AutomationRun[]
}

model AutomationRun {
  id           String    @id @default(cuid())
  automationId String
  contactEmail String
  stepIndex    Int       @default(0)
  nextRunAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([nextRunAt])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  subject   String
  body      Json
  updatedAt DateTime @updatedAt
}

model WebhookLog {
  id         String   @id @default(cuid())
  provider   String
  eventType  String
  payload    Json
  processed  Boolean  @default(false)
  error      String?
  receivedAt DateTime @default(now())
}
