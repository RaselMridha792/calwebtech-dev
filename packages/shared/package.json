{
  "name": "@calwebtech/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schemas and shared types. The single source of truth for every boundary.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auth-cookies": {
      "types": "./dist/auth-cookies.d.ts",
      "default": "./dist/auth-cookies.js"
    },
    "./slugify": {
      "types": "./dist/slugify.d.ts",
      "default": "./dist/slugify.js"
    },
    "./booking-status": {
      "types": "./dist/booking-status.d.ts",
      "default": "./dist/booking-status.js"
    },
    "./unsubscribe-token": {
      "types": "./dist/unsubscribe-token.d.ts",
      "default": "./dist/unsubscribe-token.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@calwebtech/config": "workspace:*",
    "@types/node": "22.20.2",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
